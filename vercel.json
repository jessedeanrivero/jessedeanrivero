{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/inquiremusic", "destination": "/", "permanent": true },
    { "source": "/inquire", "destination": "/", "permanent": true },
    { "source": "/artists", "destination": "/#work", "permanent": true },
    { "source": "/hillcityrecording", "destination": "/", "permanent": true },
    { "source": "/downloads", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/judahstars/sw.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/judahstars" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/judahstars/manifest.webmanifest",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
    },
    {
      "source": "/judahstars(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/frames-(desktop|mobile)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
